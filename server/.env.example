# ACHAT+ API - variables d'environnement
# Copiez ce fichier en `.env` et remplissez les valeurs.

# Base de données PostgreSQL (Neon gratuit). Créez un projet sur https://neon.tech
# puis copiez la chaîne de connexion "Pooled" fournie.
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret utilisé pour signer les tokens d'authentification admin.
# Générez une longue chaîne aléatoire.
ADMIN_SECRET=change-me-vers-une-longue-chaine-aleatoire

# Port d'écoute (Render définit PORT=10000 automatiquement).
PORT=4000